# ─────────────────────────────────────────────────────────────────────────────
# Mediview Pharmacy — environment template
# Copy to `.env.local`. NEVER commit real credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Demo mode: "true" renders the demonstration ribbon, noindexes the site and
# routes all persistence through the file-based demo adapter (.data/demo-store.json).
DEMO_MODE=true

# Public site URL — used for canonical URLs, Open Graph and sitemap generation.
# Staging example: https://mediview-demo.midexedits.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign demo staff-session cookies (HMAC).
# In production this is replaced by Supabase Auth JWTs — see supabase/README.md.
AUTH_COOKIE_SECRET=change-me-to-a-long-random-string

# ── Supabase (production adapter — leave unset in demo mode) ─────────────────
# When NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY are present the
# app selects the Supabase adapter instead of the demo file adapter.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Service-role key must NEVER be exposed to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Real business WhatsApp number (published on the current live site).
NEXT_PUBLIC_WHATSAPP_NUMBER=2347048781219
